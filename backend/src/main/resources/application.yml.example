server:
  port: 8080
  # Registers Tomcat's MBeans; the tomcat.threads and tomcat.connections gauges read its ThreadPool.
  tomcat:
    mbeanregistry:
      enabled: true

spring:
  application:
    name: wh-backend
  mongodb:
    uri: mongodb://localhost:27017/smartwarehouse
  kafka:
    bootstrap-servers: localhost:9092
  jackson:
    property-naming-strategy: SNAKE_CASE
  servlet:
    multipart:
      max-file-size: 5MB
      max-request-size: 10MB
  # Declared @Indexed / @CompoundIndex annotations are NOT created unless this is on — Spring Data
  # MongoDB has defaulted it to false since 3.0. It was off here, so every declared index in the
  # codebase (User.email, Product.sku, Zone, Line, Position, ...) existed only in the source, and
  # every filtered query was a collection scan. Safe at this scale; if a collection ever grows
  # large enough that a startup index build hurts, replace this with an explicit migration.
  data:
    mongodb:
      auto-index-creation: ${SPRING_DATA_MONGODB_AUTO_INDEX_CREATION:true}

jwt:
  secret: ${JWT_SECRET:dev-secret-change-in-prod-min-32-chars}
  expiration-ms: ${JWT_EXPIRATION_MS:86400000}

springdoc:
  api-docs:
    path: /api-docs
  swagger-ui:
    path: /swagger-ui.html

minio:
  endpoint: http://localhost:9000
  access-key: ${MINIO_ACCESS_KEY:minioadmin}
  secret-key: ${MINIO_SECRET_KEY:minioadmin}
  bucket: wh-images
  request-base: /api/v1/files/

management:
  endpoints:
    web:
      exposure:
        include: health,info

# Telemetry export. Disabled by default so a local run needs no collector; docker-compose
# turns it on. The backend must start and serve normally with the collector absent.
telemetry:
  enabled: ${TELEMETRY_ENABLED:false}
  endpoint: ${TELEMETRY_ENDPOINT:http://otel-collector:4318/v1/metrics}
  service-name: wh-backend
  export-interval-ms: 10000
  export-timeout-ms: 5000

# Read side of the metrics pipeline.
victoriametrics:
  url: ${VICTORIAMETRICS_URL:http://victoriametrics:8428}

# Backend console (SUPERADMIN only).
console:
  victorialogs-url: ${CONSOLE_VICTORIALOGS_URL:http://victorialogs:9428}
  # Service-status probes (base URLs; a blank value reports the service as UNKNOWN).
  bridge-url: ${CONSOLE_BRIDGE_URL:http://bridge:8081}
  minio-url: ${CONSOLE_MINIO_URL:http://minio:9000}
  victoriametrics-url: ${CONSOLE_VICTORIAMETRICS_URL:http://victoriametrics:8428}
  collector-url: ${CONSOLE_COLLECTOR_URL:http://otel-collector:13133}

infra:
  # Shared secret of the Infra bridge (X-Api-Key header on /infra/**). Blank rejects every call.
  api-key: ${INFRA_API_KEY:}
