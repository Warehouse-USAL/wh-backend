# SmartWarehouse Backend — environment variables
# Copy this file to .env and fill in real values (never commit .env)

# MongoDB connection string
SPRING_DATA_MONGODB_URI=mongodb://mongodb:27017/smartwarehouse

# Redpanda / Kafka bootstrap servers
REDPANDA_BOOTSTRAP_SERVERS=redpanda:9092

# JWT configuration — CHANGE IN PRODUCTION (min 32 chars)
JWT_SECRET=dev-secret-change-in-prod-min-32-chars
JWT_EXPIRATION_MS=86400000

# Spring profile: dev or prod
SPRING_PROFILES_ACTIVE=dev

# Admin user seeded on first startup
ADMIN_EMAIL=admin@smartwarehouse.local
ADMIN_PASSWORD=changeme

# Demo data — set to true against a FRESH database to seed a complete, interconnected
# demo dataset (users, products, warehouse, vehicles, orders) on first boot.
# Off by default; idempotent (skips if products already exist).
# Demo logins are documented in docs/demo-credentials.md (shared password Demo1234!).
SEED_DEMO=false

# Production only — MongoDB auth credentials
# MONGO_ROOT_USER=admin
# MONGO_ROOT_PASSWORD=changeme

# MinIO object storage — credentials for image uploads
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=wh-images

# Telemetry pipeline (OpenTelemetry Collector -> VictoriaMetrics)
TELEMETRY_ENABLED=true
TELEMETRY_ENDPOINT=http://otel-collector:4318/v1/metrics
VICTORIAMETRICS_URL=http://victoriametrics:8428
# Backend logs go to VictoriaLogs through the collector; the console's Logs page reads them back.
# TELEMETRY_LOGS_ENDPOINT=http://otel-collector:4318/v1/logs
# CONSOLE_VICTORIALOGS_URL=http://victorialogs:9428
# Every other console key (CONSOLE_*, CONSOLE_STREAM_*, TELEMETRY_*) is listed with its default in
# docs/CONSOLE.md; the defaults fit both compose files.

# Production only — GHCR tag for the backend, bridge, console and suggestions images (one release). Set it to a
# previous release (e.g. v1.4.0) and run `make deploy` to roll back.
# WH_IMAGE_TAG=latest

# Create declared MongoDB indexes at startup (off by default in Spring Data since 3.0)
SPRING_DATA_MONGODB_AUTO_INDEX_CREATION=true

# Infra bridge -- optional. `make deploy` starts it only when BOTH variables below are set; it
# fails (before touching anything) when only one is. INFRA_API_KEY is the secret shared by the
# backend (/infra/**) and the bridge: generate it with `make infra-key`.
# INFRA_AMQP_URL is RabbitMQ's AMQP port (5672), NOT the MQTT plugin port (1883).
INFRA_API_KEY=change-me-long-random-string
INFRA_AMQP_URL=amqp://user:password@infra-host:5672/

# Suggestions service (docs/SUGGESTIONS.md) — it verifies the backend's JWTs, so it reuses JWT_SECRET
# above. Dev: docker compose --profile suggestions up. Everything else has a default; see the docs.
# HOT_DECAY_FACTOR=0.97
# HOT_DECAY_INTERVAL=15m
# ORDER_DEDUPE_TTL=168h

# Text prefix of the QR code seeded on every demo position (WH2|PB1, WH2|PB2, ...). It must match
# the codes printed in the warehouse and known by Infra (docs/OPERATIONS.md).
# WH_QR_PREFIX=WH2|
