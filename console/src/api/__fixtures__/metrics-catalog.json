{
  "computed_metrics" : [ {
    "name" : "restock_suggestions",
    "path" : "/metrics/restock-suggestions",
    "display_name" : "Sugerencia de reposición",
    "description" : "Demanda diaria ponderada y, por producto, si hay que reponer y cuánto.",
    "params" : [ {
      "name" : "alpha",
      "type" : "number",
      "min" : 0.0,
      "max" : 1.0,
      "description" : "Peso de la demanda reciente frente a la de largo plazo"
    }, {
      "name" : "recent_days",
      "type" : "integer",
      "min" : 1.0,
      "max" : 364.0,
      "description" : "Días hacia atrás que cuentan como período reciente"
    }, {
      "name" : "long_days",
      "type" : "integer",
      "min" : 2.0,
      "max" : 365.0,
      "description" : "Días hacia atrás del período largo; debe ser mayor que recent_days"
    }, {
      "name" : "safety_days",
      "type" : "number",
      "min" : 0.0,
      "description" : "Días de demanda que cubre el stock de seguridad"
    }, {
      "name" : "lead_time_days",
      "type" : "number",
      "min" : 0.0,
      "description" : "Días que tarda en llegar una reposición"
    }, {
      "name" : "coverage_days",
      "type" : "number",
      "min" : 0.0,
      "description" : "Días de stock que se busca cubrir después de reponer"
    } ],
    "filters" : [ {
      "name" : "product_ids",
      "type" : "string[]",
      "description" : "Limita a estos productos; vacío o ausente = todos los activos"
    }, {
      "name" : "category",
      "type" : "string",
      "description" : "Limita a una categoría del catálogo"
    } ]
  }, {
    "name" : "suggestion_conversion",
    "path" : "/metrics/suggestion-conversion",
    "display_name" : "Conversión de sugerencias",
    "description" : "Por día, semana o mes, cuántos pedidos, líneas y unidades salieron de una recomendación (from_recommendation en POST /orders) y qué proporción representan. Los pedidos cancelados no cuentan.",
    "params" : [ {
      "name" : "from",
      "type" : "string",
      "description" : "Inicio del rango, inclusive (ISO-8601)"
    }, {
      "name" : "to",
      "type" : "string",
      "description" : "Fin del rango, exclusivo (ISO-8601); como máximo 731 días después de from"
    }, {
      "name" : "granularity",
      "type" : "string",
      "description" : "Tamaño del bucket: day, week (lunes a domingo) o month"
    } ],
    "filters" : [ {
      "name" : "time_zone",
      "type" : "string",
      "description" : "Zona horaria IANA con la que se cortan los buckets; UTC si se omite"
    }, {
      "name" : "product_ids",
      "type" : "string[]",
      "description" : "Considera solo las líneas de estos productos; vacío o ausente = todos"
    }, {
      "name" : "category",
      "type" : "string",
      "description" : "Considera solo las líneas de una categoría del catálogo"
    } ]
  } ],
