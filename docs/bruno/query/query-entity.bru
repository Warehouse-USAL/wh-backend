meta {
  name: Query Entity
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/query/:entity
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

params:path {
  entity: orders
}

body:json {
  {
    "filters": [
      { "field": "status", "op": "in", "value": ["COMPLETED", "CANCELLED"] },
      { "field": "created_at", "op": "gte", "value": "2026-08-01T00:00:00Z" }
    ],
    "sort": [{ "field": "created_at", "dir": "desc" }],
    "fields": ["id", "status", "created_at", "assigned_vehicle_id"],
    "page": 0,
    "size": 50
  }
}

docs {
  Entities: orders, products, vehicles, users (users requires admin_system).

  Operators: eq, ne, gt, gte, lt, lte, in, nin, contains, exists.
  `contains` matches an escaped literal — it is not a regex the caller supplies.

  Field names accept either spelling: created_at or createdAt.

  Rejections: UNKNOWN_ENTITY, UNKNOWN_FIELD, UNSUPPORTED_OPERATOR, TOO_MANY_FILTERS,
  INVALID_FILTER_VALUE (400).

  Ceilings: size <= 100, at most 10 filters, always sorted.
}
