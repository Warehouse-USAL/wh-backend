meta {
  name: Create Product
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/products
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "sku": "SKU-001",
    "name": "Laptop Pro 15",
    "description": "High-performance laptop",
    "category": "electronics",
    "image_url": null,
    "available_stock": 50,
    "max_quantity_per_order": 5,
    "minimum_stock": 10,
    "zone": "A",
    "line": "1",
    "position": "A-1-01",
    "height": "medium"
  }
}
