meta {
  name: Reset Password
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/users/:id/reset-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

params:path {
  id: USER_ID_HERE
}

body:json {
  {
    "new_password": "NewSecurePass123!"
  }
}
