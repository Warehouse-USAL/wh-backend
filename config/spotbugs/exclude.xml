<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Spring constructor injection stores service references, not mutable data -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Class name="~.*(Controller|Config|Repository|Service|Consumer)"/>
    </Match>
    <!-- Product is an intentionally mutable MongoDB document class; defensive copies on
         embedded value objects (Price, ProductImage, Spec) would conflict with Spring Data
         MongoDB's reflective field-setting during deserialization. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Class name="~com\.usal\.whbackend\.domain\.Product(\$.*)?"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Class name="~com\.usal\.whbackend\.domain\.Product(\$.*)?"/>
    </Match>
    <!-- The two query request DTOs hold an unmodifiable wrapper around a private defensive copy,
         so the fields genuinely cannot be mutated from outside. SpotBugs recognises List.copyOf as
         immutable but not Collections.unmodifiableList(new ArrayList<>(..)), hence the false
         positive. The wrapper is required rather than cosmetic: copyOf rejects null entries, and a
         null filter value must reach the translator so it can answer 400 INVALID_FILTER_VALUE.
         Dropping it silently would run the query unfiltered — a wrong answer, not an error. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Class name="~com\.usal\.whbackend\.api\.(metrics\.MetricsQueryRequest|query\.EntityQueryRequest)"/>
    </Match>
    <!-- Result carries the Vehicle document straight out of the atomic findAndModify it just ran —
         the same live, intentionally-mutable Spring Data Mongo document every other Vehicle-returning
         method in this codebase hands back uncopied. Defensive-copying it here would be inconsistent
         with that pattern and serves no purpose (callers only ever read it before it's serialised or
         broadcast). -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="~com\.usal\.whbackend\.repository\.kafka\.VehicleUpdateExecutor\$Result"/>
    </Match>
</FindBugsFilter>
