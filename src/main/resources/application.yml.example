server:
  port: 8080

spring:
  application:
    name: wh-backend
  mongodb:
    uri: mongodb://localhost:27017/smartwarehouse
  kafka:
    bootstrap-servers: localhost:9092
  jackson:
    property-naming-strategy: SNAKE_CASE

jwt:
  secret: ${JWT_SECRET:dev-secret-change-in-prod-min-32-chars}
  expiration-ms: ${JWT_EXPIRATION_MS:86400000}

springdoc:
  api-docs:
    path: /api-docs
  swagger-ui:
    path: /swagger-ui.html

management:
  endpoints:
    web:
      exposure:
        include: health,info
